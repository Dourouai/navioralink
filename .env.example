QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Enables the Qwen API locally without Supabase. Keep false for production.
QWEN_LOCAL_TEST_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
CRON_SECRET=
SUPABASE_SITE_URL=https://naviora.link
SUPABASE_AUTH_URI_ALLOW_LIST=http://localhost:3001/**,https://naviora.link/**,https://*.vercel.app/**
NEXT_PUBLIC_GO_URL=https://go.naviora.link
NEXT_PUBLIC_DEFAULT_ENTRY_PATH_PREFIX=l

# Tencent Cloud CAPTCHA
NEXT_PUBLIC_TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_SECRET_ID=
TENCENT_CAPTCHA_SECRET_KEY=
TENCENT_CAPTCHA_APP_SECRET_KEY=
TENCENT_CAPTCHA_REGION=ap-singapore
TENCENT_CAPTCHA_ENDPOINT=captcha.intl.tencentcloudapi.com

# Creem billing
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_STARTER_MONTHLY_PRODUCT_ID=
CREEM_STARTER_YEARLY_PRODUCT_ID=
CREEM_PREMIUM_MONTHLY_PRODUCT_ID=
CREEM_PREMIUM_YEARLY_PRODUCT_ID=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Naviora
BREVO_REPLY_TO_EMAIL=
BREVO_REPLY_TO_NAME=Naviora Support
BREVO_SANDBOX=true

# Supabase Auth custom SMTP (configure these in the Supabase dashboard)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
