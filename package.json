{
  "name": "naviora-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace naviora-app",
    "dev:public": "npm run dev --workspace naviora-public",
    "build:web": "npm run build --workspace naviora-app",
    "build:public": "npm run build --workspace naviora-public",
    "lint:web": "npm run lint --workspace naviora-app",
    "lint:public": "npm run lint --workspace naviora-public",
    "format": "prettier --write .",
    "supabase:auth:smtp": "node scripts/configure-supabase-auth-smtp.mjs",
    "self-check:backend": "node scripts/check-backend-setup.mjs"
  },
  "overrides": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
